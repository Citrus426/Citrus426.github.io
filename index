        description: "让产品回到材质、形状与光影本身。演示创作设定：为小众香氛品牌建立简洁、稳定、适合电商与品牌页面的静物视觉。",
        featured: false
      }
    ];

    const $ = (selector, root = document) => root.querySelector(selector);
    const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const imageUrl = (photo, width = 1000) =>
      `https://images.unsplash.com/${photo}?auto=format&fit=crop&w=${width}&q=85`;

    $("#year").textContent = String(new Date().getFullYear());

    // Mobile navigation.
    const menuToggle = $("#menu-toggle");
    const nav = $("#main-nav");

    function setMenu(open, returnFocus = false) {
      nav.classList.toggle("is-open", open);
      menuToggle.setAttribute("aria-expanded", String(open));
      menuToggle.setAttribute("aria-label", open ? "关闭导航" : "打开导航");
      menuToggle.firstElementChild.textContent = open ? "×" : "☰";
      if (returnFocus) menuToggle.focus();
    }

    menuToggle.addEventListener("click", () => {
      setMenu(menuToggle.getAttribute("aria-expanded") !== "true");
    });

    $$("a", nav).forEach(link => link.addEventListener("click", () => setMenu(false)));

    document.addEventListener("click", event => {
      if (!nav.contains(event.target) && !menuToggle.contains(event.target)) {
        setMenu(false);
      }
    });

    document.addEventListener("keydown", event => {
      if (event.key === "Escape" && menuToggle.getAttribute("aria-expanded") === "true") {
        setMenu(false, true);
      }
    });

    document.addEventListener("focusin", event => {
      if (!nav.contains(event.target) && !menuToggle.contains(event.target)) {
        setMenu(false);
      }
    });

    window.matchMedia("(min-width: 761px)").addEventListener("change", event => {
      if (event.matches) setMenu(false);
    });

    // Hero slideshow: pausable, tab visibility aware, reduced-motion aware.
    const hero = $(".hero");
    const slides = $$(".hero-image");
    const slideButtons = $$(".slide-dot");
    const captions = [
      "01 / 静谧原野 · THE QUIET WILD",
      "02 / 山的另一边 · BEYOND THE MOUNTAINS",
      "03 / 林间来信 · LETTERS FROM THE FOREST"
    ];
    let slideIndex = 0;
    let slideTimer = null;
    let userPaused = reducedMotion.matches;
    let heroFocused = false;

    function showSlide(index) {
      slideIndex = index;
      slides.forEach((slide, i) => slide.classList.toggle("active", i === index));
      slideButtons.forEach((button, i) => {
        button.setAttribute("aria-pressed", String(i === index));
      });
      $("#hero-caption").textContent = captions[index];
    }

    function syncSlideshow() {
      window.clearInterval(slideTimer);
      slideTimer = null;
      const pauseButton = $("#pause-slides");
      pauseButton.textContent = userPaused ? "播放" : "暂停";
      pauseButton.setAttribute("aria-label", userPaused ? "播放背景轮播" : "暂停背景轮播");

      if (!userPaused && !document.hidden && !heroFocused) {
        slideTimer = window.setInterval(() => {
          showSlide((slideIndex + 1) % slides.length);
        }, 6500);
      }
    }

    slideButtons.forEach(button => {
      button.addEventListener("click", () => {
        showSlide(Number(button.dataset.slide));
        userPaused = true;
        syncSlideshow();
      });
    });

    $("#pause-slides").addEventListener("click", () => {
      userPaused = !userPaused;
      syncSlideshow();
    });

    hero.addEventListener("focusin", () => {
      heroFocused = true;
      syncSlideshow();
    });
    hero.addEventListener("focusout", () => {
      queueMicrotask(() => {
        heroFocused = hero.contains(document.activeElement);
        syncSlideshow();
      });
    });
    document.addEventListener("visibilitychange", syncSlideshow);
    reducedMotion.addEventListener("change", event => {
      userPaused = event.matches;
      syncSlideshow();
    });

    slides.forEach(image => {
      const fallback = () => { image.hidden = true; };
      image.addEventListener("error", fallback);
      if (image.complete && !image.naturalWidth) fallback();
    });
    syncSlideshow();

    // Portfolio rendering uses DOM APIs and textContent.
    const portfolioGrid = $("#portfolio-grid");
    let currentFilter = "all";
    let visibleWorks = works.slice();

    function createWorkCard(work, index) {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "work-card";
      button.id = `work-${work.id}`;
      if (currentFilter === "all" && work.featured) button.classList.add("featured");
      button.setAttribute("aria-label", `查看作品：${work.title}，${work.categoryLabel.split(" / ")[0]}`);
      button.setAttribute("aria-haspopup", "dialog");

      const image = document.createElement("img");
      image.alt = work.alt;
      image.loading = "lazy";
      image.decoding = "async";
      image.style.objectPosition = work.position;
      image.addEventListener("error", () => { image.hidden = true; });
      image.src = imageUrl(work.photo);

      const info = document.createElement("span");
      info.className = "work-info";

      const category = document.createElement("span");
      category.className = "work-category";
      category.textContent = work.categoryLabel;

      const title = document.createElement("span");
      title.className = "work-title";
      title.textContent = work.title;

      const meta = document.createElement("span");
      meta.className = "work-meta";
      meta.textContent = work.meta;

      const arrow = document.createElement("span");
      arrow.className = "work-arrow";
      arrow.setAttribute("aria-hidden", "true");
      arrow.textContent = "↗";

      info.append(category, title, meta, arrow);
      button.append(image, info);
      button.addEventListener("click", () => openWork(index, button));
      return button;
    }

    function renderWorks() {
      visibleWorks = currentFilter === "all"
        ? works.slice()
        : works.filter(work => work.category === currentFilter);

      const fragment = document.createDocumentFragment();
      visibleWorks.forEach((work, index) => fragment.append(createWorkCard(work, index)));
      portfolioGrid.replaceChildren(fragment);
      $("#work-count").textContent = `${String(visibleWorks.length).padStart(2, "0")} 件作品`;

      $$(".filter").forEach(button => {
        button.setAttribute("aria-pressed", String(button.dataset.filter === currentFilter));
      });
    }

    $$(".filter").forEach(button => {
      button.addEventListener("click", () => {
        currentFilter = button.dataset.filter;
        renderWorks();
      });
    });

    // Lightbox: native modal focus containment and Escape handling.
    const dialog = $("#work-dialog");
    let dialogIndex = 0;
    let dialogOpener = null;
    let dialogImageVersion = 0;

    function updateDialog() {
      const work = visibleWorks[dialogIndex];
      $("#dialog-title").textContent = work.title;
      $("#dialog-description").textContent = work.description;
      $("#dialog-counter").textContent =
        `${dialogIndex + 1} / ${visibleWorks.length} · ${work.categoryLabel}`;

      const version = ++dialogImageVersion;
      const image = document.createElement("img");
      image.id = "dialog-image";
      image.alt = work.alt;
      image.decoding = "async";
      $("#image-unavailable").hidden = true;

      image.addEventListener("error", () => {
        if (version !== dialogImageVersion) return;
        image.hidden = true;
        $("#image-unavailable").hidden = false;
      });

      $("#dialog-image").replaceWith(image);
      image.src = imageUrl(work.photo, 1800);

      $("#dialog-prev").disabled = visibleWorks.length < 2;
      $("#dialog-next").disabled = visibleWorks.length < 2;
    }

    function openWork(index, opener) {
      dialogIndex = index;
      dialogOpener = opener;
      updateDialog();
      dialog.showModal();
      document.body.classList.add("modal-open");
    }

    function stepWork(direction) {
      dialogIndex = (dialogIndex + direction + visibleWorks.length) % visibleWorks.length;
      updateDialog();
    }

    $("#dialog-close").addEventListener("click", () => dialog.close());
    $("#dialog-prev").addEventListener("click", () => stepWork(-1));
    $("#dialog-next").addEventListener("click", () => stepWork(1));

    dialog.addEventListener("keydown", event => {
      if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
        event.preventDefault();
        stepWork(event.key === "ArrowLeft" ? -1 : 1);
      }
    });

    // Close only when a click falls outside the dialog's actual rectangle.
    dialog.addEventListener("click", event => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      const outside = event.clientX < rect.left || event.clientX > rect.right ||
                      event.clientY < rect.top || event.clientY > rect.bottom;
      if (outside) dialog.close();
    });

    dialog.addEventListener("close", () => {
      document.body.classList.remove("modal-open");
      if (dialogOpener?.isConnected) dialogOpener.focus({ preventScroll: true });
    });

    $("#book-similar").addEventListener("click", () => {
      const work = visibleWorks[dialogIndex];
      dialog.close();
      // Wait for native dialog focus restoration before focusing the form.
      window.setTimeout(() => {
        $("#service").value = work.category === "commercial" ? "commercial" : "portrait";
        if (!$("#booking-message").value.trim()) {
          $("#booking-message").value = `我喜欢《${work.title}》的视觉风格，想聊聊适合我的拍摄方案。`;
        }
        validateField($("#service"));
        $("#booking-result").textContent = "";
        $("#booking").scrollIntoView({ behavior: reducedMotion.matches ? "instant" : "smooth" });
        $("#customer-name").focus({ preventScroll: true });
      }, 0);
    });

    renderWorks();

    // Mock availability. Use a fixed UTC+8 business date, avoiding UTC date slicing bugs.
    const dateInput = $("#booking-date");
    const slotInput = $("#booking-slot");
    const slots = [
      { value: "morning", label: "09:00–12:00" },
      { value: "afternoon", label: "14:00–17:00" },
      { value: "sunset", label: "17:30–19:30" }
    ];

    function businessToday() {
      const parts = new Intl.DateTimeFormat("en-US", {
        timeZone: "Asia/Shanghai",
        year: "numeric",
        month: "2-digit",
        day: "2-digit"
      }).formatToParts(new Date());

      const getPart = type => parts.find(part => part.type === type).value;
      return `${getPart("year")}-${getPart("month")}-${getPart("day")}`;
    }

    function addDays(dateString, days) {
      const date = new Date(`${dateString}T12:00:00Z`);
      date.setUTCDate(date.getUTCDate() + days);
      const year = date.getUTCFullYear();
      const month = String(date.getUTCMonth() + 1).padStart(2, "0");
      const day = String(date.getUTCDate()).padStart(2, "0");
      return `${year}-${month}-${day}`;
    }

    function updateDateBounds() {
      const today = businessToday();
      dateInput.min = addDays(today, 1);
      dateInput.max = addDays(today, 90);
      $("#date-hint").textContent = `${dateInput.min} 至 ${dateInput.max}；周一休息。`;
    }

    function validDate(dateString) {
      if (!/^\d{4}-\d{2}-\d{2}$/.test(dateString)) return false;
      const date = new Date(`${dateString}T12:00:00Z`);
      if (Number.isNaN(date.getTime())) return false;
      return addDays(dateString, 0) === dateString &&
             dateString >= dateInput.min &&
             dateString <= dateInput.max;
    }

    function availableSlots(dateString) {
      if (!validDate(dateString)) return [];
      const date = new Date(`${dateString}T12:00:00Z`);
      if (date.getUTCDay() === 1) return [];
      // Stable demo rule: every month's 11th and 22nd are full.
      const day = date.getUTCDate();
      if (day === 11 || day === 22) return [];
      const seed = Number(dateString.replaceAll("-", ""));
      return slots.filter((slot, index) => (seed + index) % 4 !== 0);
    }

    function refreshSlots() {
      updateDateBounds();
      slotInput.replaceChildren();
      const options = availableSlots(dateInput.value);

      let placeholder = "请先选择日期";
      if (dateInput.value && !validDate(dateInput.value)) placeholder = "请先选择有效日期";
      else if (dateInput.value && options.length === 0) placeholder = "当日暂无档期，请更换日期";
      else if (options.length) placeholder = "请选择时段";

      slotInput.add(new Option(placeholder, ""));
      options.forEach(slot => slotInput.add(new Option(slot.label, slot.value)));
      slotInput.disabled = options.length === 0;
      setFieldError(slotInput, "");

      $("#slot-hint").textContent = options.length
        ? `模拟剩余 ${options.length} 个时段，杭州时间（UTC+8）。`
        : "模拟排期按杭州时间（UTC+8）。";
    }

    updateDateBounds();

    dateInput.addEventListener("focus", updateDateBounds);
    dateInput.addEventListener("change", () => {
      refreshSlots();
      validateField(dateInput);
    });

    // Custom validation provides inline errors and focuses the first invalid field.
    const bookingForm = $("#booking-form");
    const bookingSubmit = $("#booking-submit");
    const bookingResult = $("#booking-result");
    const requiredFields = [
      $("#customer-name"),
      $("#customer-phone"),
      $("#customer-email"),
      $("#service"),
      dateInput,
      slotInput,
      $("#consent")
    ];

    function setFieldError(field, message) {
      field.setAttribute("aria-invalid", String(Boolean(message)));
      const error = document.getElementById(`${field.id}-error`);
      if (error) error.textContent = message;
    }

    function emailError(field) {
      if (!field.value.trim()) return "请输入电子邮箱。";
      if (field.validity.typeMismatch || field.value.length > 120) {
        return "请输入有效的邮箱地址，例如 you@example.com。";
      }
      return "";
    }

    function getFieldError(field) {
      const value = field.value.trim();

      switch (field.id) {
        case "customer-name":
          return value.length < 2 || value.length > 40
            ? "请输入 2–40 个字符的称呼。" : "";

        case "customer-phone": {
          const digits = value.replace(/\D/g, "");
          const permitted = /^\+?[\d\s()-]+$/.test(value);
          return !permitted || digits.length < 7 || digits.length > 15
            ? "请输入 7–15 位数字的电话，可包含 +、空格、括号和短横线。" : "";
        }

        case "customer-email":
          return emailError(field);

        case "service":
          return ["portrait", "couple", "commercial"].includes(value)
            ? "" : "请选择拍摄类型。";

        case "booking-date":
          if (!value) return "请选择期望日期。";
          if (!validDate(value)) return "请选择明天起、未来 90 天内的日期。";
          if (!availableSlots(value).length) return "该日期休息或模拟档期已满，请换一天。";
          return "";

        case "booking-slot":
          if (!validDate(dateInput.value) || !availableSlots(dateInput.value).length) return "";
          return availableSlots(dateInput.value).some(slot => slot.value === value)
            ? "" : "请选择一个可用时段。";

        case "consent":
          return field.checked ? "" : "请先确认你已理解演示说明。";

        default:
          return "";
      }
    }

    function validateField(field) {
      const message = getFieldError(field);
      setFieldError(field, message);
      return !message;
    }

    requiredFields.forEach(field => {
      field.addEventListener("blur", () => validateField(field));
      const eventName = field.tagName === "SELECT" || field.type === "checkbox" ||
                        field.type === "date" ? "change" : "input";
      field.addEventListener(eventName, () => {
        if (field.getAttribute("aria-invalid") === "true") validateField(field);
        bookingResult.textContent = "";
      });
    });

    $("#booking-message").addEventListener("input", () => {
      bookingResult.textContent = "";
    });

    const wait = milliseconds => new Promise(resolve => window.setTimeout(resolve, milliseconds));
    let bookingBusy = false;

    bookingForm.addEventListener("submit", async event => {
      event.preventDefault();
      if (bookingBusy) return;

      updateDateBounds();
      bookingResult.textContent = "";
      bookingResult.classList.remove("is-error");

      const invalidFields = requiredFields.filter(field => !validateField(field));
      if (invalidFields.length) {
        bookingResult.classList.add("is-error");
        bookingResult.textContent = "还有信息需要补充，请检查标出的字段。";
        invalidFields[0].focus();
        return;
      }

      const selection = {
        date: dateInput.value,
        slot: slots.find(slot => slot.value === slotInput.value).label,
        service: $("#service").selectedOptions[0].textContent.split(" · ")[0]
      };

      const controls = $$("input, select, textarea, button", bookingForm);
      const disabledStates = controls.map(control => control.disabled);
      const originalButtonText = bookingSubmit.textContent;
      bookingBusy = true;
      bookingForm.setAttribute("aria-busy", "true");
      controls.forEach(control => { control.disabled = true; });
      bookingSubmit.textContent = "正在生成模拟确认…";

      try {
        await wait(700);
        const randomPart = Math.random().toString(36).slice(2, 6).toUpperCase();
        const reference = `DEMO-${Date.now().toString(36).toUpperCase()}-${randomPart}`;

        bookingResult.textContent =
          `模拟提交成功。体验编号：${reference}。` +
          `你的选择：${selection.date} ${selection.slot}（杭州时间），${selection.service}。` +
          "本次未发送任何预约信息，也未锁定档期。";

        // Clear entered personal data after the mock interaction completes.
        bookingForm.reset();
        requiredFields.forEach(field => setFieldError(field, ""));
      } catch (error) {
        bookingResult.classList.add("is-error");
        bookingResult.textContent = "页面暂时无法完成模拟提交，请稍后重试。";
      } finally {
        controls.forEach((control, index) => { control.disabled = disabledStates[index]; });
        bookingSubmit.textContent = originalButtonText;
        bookingForm.setAttribute("aria-busy", "false");
        bookingBusy = false;
        refreshSlots();
      }
    });

    bookingSubmit.disabled = false;

    // Newsletter: session-only duplicate detection; nothing is transmitted.
    const newsletterForm = $("#newsletter-form");
    const newsletterEmail = $("#newsletter-email");
    const newsletterSubmit = $("#newsletter-submit");
    const newsletterResult = $("#newsletter-result");
    const subscribedInSession = new Set();
    let newsletterBusy = false;

    newsletterEmail.addEventListener("input", () => {
      newsletterEmail.setAttribute("aria-invalid", "false");
      $("#newsletter-error").textContent = "";
      newsletterResult.textContent = "";
    });

    newsletterForm.addEventListener("submit", async event => {
      event.preventDefault();
      if (newsletterBusy) return;
      newsletterResult.textContent = "";
      newsletterEmail.value = newsletterEmail.value.trim();

      const error = emailError(newsletterEmail);
      newsletterEmail.setAttribute("aria-invalid", String(Boolean(error)));
      $("#newsletter-error").textContent = error;
      if (error) {
        newsletterEmail.focus();
        return;
      }

      const email = newsletterEmail.value.toLowerCase();
      if (subscribedInSession.has(email)) {
        newsletterResult.textContent = "该邮箱本次已体验过模拟订阅，未重复处理。";
        return;
      }

      newsletterBusy = true;
      newsletterForm.setAttribute("aria-busy", "true");
      newsletterSubmit.disabled = true;
      newsletterEmail.disabled = true;
      newsletterSubmit.textContent = "处理中…";

      try {
        await wait(500);
        subscribedInSession.add(email);
        newsletterResult.textContent = "模拟订阅成功。本次未发送邮件，也未加入真实订阅名单。";
        newsletterForm.reset();
      } catch (error) {
        newsletterResult.textContent = "暂时无法完成模拟订阅，请重试。";
      } finally {
        newsletterBusy = false;
        newsletterForm.setAttribute("aria-busy", "false");
        newsletterSubmit.disabled = false;
        newsletterEmail.disabled = false;
        newsletterSubmit.textContent = "模拟订阅 ↗";
      }
    });

    newsletterSubmit.disabled = false;

    // Native details works without JS; JS adds one-open-per-group behavior.
    $$(".accordion-group").forEach(group => {
      const entries = $$("details", group);
      entries.forEach(entry => {
        entry.addEventListener("toggle", () => {
          if (!entry.open) return;
          entries.forEach(other => {
            if (other !== entry) other.open = false;
          });
        });
      });
    });

    // Progressive section reveal.
    if ("IntersectionObserver" in window && !reducedMotion.matches) {
      document.documentElement.classList.add("reveal-enabled");
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08 });

      $$(".reveal").forEach(element => observer.observe(element));
    }
  </script>
</body>
</html>
